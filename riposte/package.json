{
  "name": "dawnwick",
  "version": "0.16.0",
  "private": true,
  "description": "Dawnwick: The Last Word, a phone-first counter-chain roguelike deckbuilder.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx sim/tests.ts && tsx sim/story-tests.ts",
    "sim": "tsx sim/simulate.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "catalog": "tsx sim/catalog.ts",
    "audit": "tsx sim/audit.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "7.2.0",
    "@capacitor/ios": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.2.0",
    "@types/node": "^22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0"
  }
}
